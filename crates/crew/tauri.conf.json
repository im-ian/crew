{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crew",
  "version": "0.1.0",
  "identifier": "dev.jthefloor.crew",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crew",
        "width": 1120,
        "height": 740,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 18 },
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "/tmp/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Local multi-agent desktop for grok/claude/codex CLIs",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/im-ian/crew/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDY4MkVGMTk4NjZBNgpSV1NtWnBqeExtaFVDdW5saitqOW5RNGRQQlRqSExad284bXRiejdyamgrOTlVcldURit5WW8vZgo="
    }
  }
}
