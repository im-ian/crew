{
  "identifier": "default",
  "description": "Main window talks to the local crew daemon",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:1420",
      "http://127.0.0.1:1420/*",
      "http://localhost:1420",
      "http://localhost:1420/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-list-agents",
    "allow-list-channels",
    "allow-send-message",
    "allow-stop-agent",
    "allow-approve-agent",
    "allow-tell-message",
    "allow-add-channel",
    "allow-set-channel",
    "allow-leave-channel",
    "allow-remove-channel",
    "allow-channel-send",
    "allow-get-snapshot",
    "allow-get-messages",
    "allow-get-channel-messages",
    "allow-daemon-ping",
    "allow-reset-agent",
    "allow-set-agent",
    "allow-add-agent",
    "allow-clone-agent",
    "allow-remove-agent",
    "allow-set-avatar",
    "allow-clear-avatar",
    "allow-add-routine",
    "allow-remove-routine",
    "allow-set-routine-enabled",
    "allow-run-routine",
    "allow-edit-routine",
    "allow-list-routine-runs",
    "allow-get-memory",
    "allow-set-memory",
    "allow-list-groups",
    "allow-set-groups",
    "allow-list-models",
    "allow-search-crew",
    "allow-list-skills",
    "allow-lookup-skill",
    "allow-save-skill",
    "allow-remove-skill",
    "allow-save-upload",
    "allow-peek-pending-focus",
    "allow-take-pending-focus",
    "allow-open-path",
    "allow-set-dock-badge",
    "allow-set-locale"
  ]
}
